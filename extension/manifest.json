{
  "manifest_version": 3,
  "name": "TruthWeave Misinformation Detector",
  "version": "1.0.0",
  "description": "Verify claims, text, and media content dynamically.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
