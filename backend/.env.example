PROJECT_NAME="TruthWeave"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database (PostgreSQL) - Use 127.0.0.1 for IPv4 to avoid localhost / ::1 resolution issues on Windows
DATABASE_URL="postgresql://admin:your_password_here@127.0.0.1:5432/truthweave"

# External APIs
GEMINI_API_KEY=""
